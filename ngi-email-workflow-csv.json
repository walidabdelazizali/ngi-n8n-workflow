{
  "name": "NGI Dubai Hills Mall Email Campaign (CSV)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "filePath": "/path/to/your/sample-clients.csv",
        "options": {}
      },
      "id": "2",
      "name": "Read CSV File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "mode": "jsonToCsv",
        "options": {}
      },
      "id": "3",
      "name": "Convert CSV to JSON",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "Your Dubai Hills Mall Insurance – NGI",
        "emailType": "text",
        "message": "=Hello {{ $json.Name }},\n\nThis is Waleed Abdelaziz from National General Insurance (NGI).\nWe help Dubai Hills Mall retailers get their required insurance coverage quickly and affordably.\n\n{{ $json.Message }}\n\nPlease share your Trade License, VAT Certificate, and Employee Excel Sheet here:\n[Google Form link]\n\nBest regards,\nWaleed Abdelaziz\nCorporate Insurance Consultant\nNGI – National General Insurance",
        "options": {}
      },
      "id": "4",
      "name": "Send Email via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        910,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Read CSV File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read CSV File": {
      "main": [
        [
          {
            "node": "Convert CSV to JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert CSV to JSON": {
      "main": [
        [
          {
            "node": "Send Email via Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
